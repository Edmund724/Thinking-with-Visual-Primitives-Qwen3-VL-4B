# Copy this file to .env and fill in your own keys/URLs.
# The .env file is ignored by git by default.

# OpenAI-compatible API key (used by quality_reward_api LLM-as-Judge)
OPENAI_API_KEY=sk-your-key-here

# OpenAI-compatible API base URL.
# Examples:
#   OpenAI: https://api.openai.com/v1
#   Azure:  https://your-resource.openai.azure.com/
#   vLLM:   http://localhost:8000/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Judge model for Quality RM. Use a cheap, fast model.
# Examples: gpt-4o-mini, gpt-3.5-turbo, Qwen/Qwen3-8B (via vLLM)
QUALITY_RM_MODEL=gpt-4o-mini

# Optional: timeout seconds for Quality RM API calls
QUALITY_RM_TIMEOUT=30

# Optional: max retries for transient failures
QUALITY_RM_MAX_RETRIES=2
